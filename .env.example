# Tinig Turo browser configuration.
# Copy to .env.local and fill in. Everything prefixed VITE_ is visible to the browser,
# so ONLY the project URL and the publishable (anon) key belong here.
# NEVER put the service-role / secret key in any VITE_ variable or commit it anywhere.

# Supabase project URL, e.g. https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=

# Supabase publishable key (sb_publishable_...) or legacy anon key.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional, experimental: on-device speech recognition with the Vosk WASM engine.
# Disabled by default until it has been benchmarked on your target devices
# (see docs/SPEECH.md). Set to "true" to show the engine on the Offline downloads screen.
VITE_ENABLE_VOSK=false

# URL of a Vosk model archive (.tar.gz or .zip) that your server allows the app to fetch
# (same origin or CORS-enabled). Example: /models/vosk-model-small-en-us-0.15.tar.gz
VITE_VOSK_MODEL_URL_EN=
